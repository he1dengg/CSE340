<%- include('partials/header') %>
<section class="detail-card">
  <h1 class="page-title"><%= category.category_name %></h1>
  <p class="section-description">Service projects listed under this focus category:</p>
</section>

<% if (projects.length === 0) { %>
  <p class="section-description">No active service projects registered for this category yet.</p>
<% } else { %>
  <ul class="items-list">
    <% projects.forEach((proj) => { %>
      <li class="list-item">
        <div>
          <span class="list-item-title"><a href="/project/<%= proj.project_id %>"><%= proj.project_name %></a></span>
          <p class="org-meta" style="margin-top: 0.35rem;">Partner: <a href="/organization/<%= proj.org_id %>"><%= proj.org_name %></a></p>
        </div>
      </li>
    <% }) %>
  </ul>
<% } %>
<%- include('partials/footer') %>
