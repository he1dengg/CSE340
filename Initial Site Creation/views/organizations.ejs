<%- include('partials/header') %>
<section class="content-section">
  <h1 class="page-title"><%= title %></h1>
  <p class="section-description">Partner non-profits and community organizations driving positive local change.</p>
  <div class="card-grid">
    <article class="card">
      <img src="/images/org-placeholder.svg" alt="Green Habitat Alliance logo" class="card-img">
      <div class="card-body">
        <h2>Green Habitat Alliance</h2>
        <p>Restoring urban forestry, creating community gardens, and organizing regular park clean-ups.</p>
      </div>
    </article>
    <article class="card">
      <img src="/images/org-placeholder.svg" alt="Youth Education Forward logo" class="card-img">
      <div class="card-body">
        <h2>Youth Education Forward</h2>
        <p>Delivering after-school tutoring and reading assistance for primary school students.</p>
      </div>
    </article>
  </div>
</section>
<%- include('partials/footer') %>
