<%- include('partials/header') %>
<section class="content-section">
  <h1 class="page-title"><%= title %></h1>
  <p class="section-description">Partner non-profits and community organizations driving positive local change.</p>
  <div class="card-grid">
    <% orgs.forEach((org) => { %>
      <article class="card">
        <img src="/images/org-placeholder.svg" alt="Partner Logo" class="card-img">
        <div class="card-body">
          <h2><%= org.org_name %></h2>
          <p><%= org.org_description %></p>
        </div>
      </article>
    <% }) %>
  </div>
</section>
<%- include('partials/footer') %>
