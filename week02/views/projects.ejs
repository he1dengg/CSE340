<%- include('partials/header') %>
<div class="page-header">
  <h1 class="page-title"><%= title %></h1>
  <p class="page-subtitle">Browse upcoming service projects and make your mark.</p>
</div>
<div class="grid">
  <% 
    const pImgs = [
      'https://images.unsplash.com/photo-1593113554652-32b49b0ebcd8?q=80&w=800&auto=format&fit=crop',
      'https://images.unsplash.com/photo-1542601906990-b4d3fb778b09?q=80&w=800&auto=format&fit=crop',
      'https://images.unsplash.com/photo-1524178232363-1fb2b075b655?q=80&w=800&auto=format&fit=crop',
      'https://images.unsplash.com/photo-1582213782179-e0d53f98f2ca?q=80&w=800&auto=format&fit=crop',
      'https://images.unsplash.com/photo-1531206715517-5c0ba140bdea?q=80&w=800&auto=format&fit=crop',
      'https://images.unsplash.com/photo-1488521787991-ed7bbaae773c?q=80&w=800&auto=format&fit=crop'
    ];
  %>
  <% projects.forEach((proj, idx) => { %>
    <article class="card">
      <div class="card-img-wrapper">
        <img src="<%= pImgs[idx % pImgs.length] %>" class="card-img" alt="Project Image" onerror="this.src='/images/org-placeholder.svg'">
      </div>
      <div class="card-content">
        <h2 class="card-title"><a href="/project/<%= proj.project_id %>"><%= proj.project_name %></a></h2>
        <p class="card-meta">By <a href="/organization/<%= proj.org_id %>"><%= proj.org_name %></a></p>
        <p class="card-text"><%= proj.project_description %></p>
        <div class="card-footer">
          <span>📍 <%= proj.location %></span>
          <span>📅 <%= new Date(proj.project_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></span>
        </div>
      </div>
    </article>
  <% }) %>
</div>
<%- include('partials/footer') %>
