<%- include('partials/header') %>
<% 
  const detailImgs = [
    'https://images.unsplash.com/photo-1593113554652-32b49b0ebcd8?q=80&w=1200&auto=format&fit=crop',
    'https://images.unsplash.com/photo-1542601906990-b4d3fb778b09?q=80&w=1200&auto=format&fit=crop',
    'https://images.unsplash.com/photo-1524178232363-1fb2b075b655?q=80&w=1200&auto=format&fit=crop',
    'https://images.unsplash.com/photo-1582213782179-e0d53f98f2ca?q=80&w=1200&auto=format&fit=crop',
    'https://images.unsplash.com/photo-1531206715517-5c0ba140bdea?q=80&w=1200&auto=format&fit=crop',
    'https://images.unsplash.com/photo-1488521787991-ed7bbaae773c?q=80&w=1200&auto=format&fit=crop'
  ];
  const headerImg = detailImgs[(project.project_id - 1) % detailImgs.length];
%>
<div class="detail-hero">
  <img src="<%= headerImg %>" class="detail-hero-img" alt="Project Hero" onerror="this.src='/images/org-placeholder.svg'">
  <div class="detail-hero-overlay">
    <h1 style="font-size: 3.5rem; font-weight: 800; color: #ffffff; margin-bottom: 0.5rem; text-shadow: 0 2px 10px rgba(0,0,0,0.5);"><%= project.project_name %></h1>
    <p style="font-size: 1.25rem; color: #e2e8f0; font-weight: 500;">Organized by <a href="/organization/<%= project.org_id %>" style="color: #60a5fa; text-decoration: none;"><%= project.org_name %></a></p>
    <div class="tag-container">
      <% if (categories.length === 0) { %>
        <span class="category-tag">Uncategorized</span>
      <% } else { %>
        <% categories.forEach((cat) => { %>
          <a href="/category/<%= cat.category_id %>" class="category-tag"><%= cat.category_name %></a>
        <% }) %>
      <% } %>
    </div>
  </div>
</div>
<div style="background: var(--surface); padding: 4rem; border-radius: var(--radius-lg); box-shadow: var(--shadow); border: 1px solid var(--border); backdrop-filter: blur(16px);">
  <div style="display: flex; gap: 3rem; margin-bottom: 3rem; padding-bottom: 2rem; border-bottom: 1px solid var(--border); flex-wrap: wrap;">
    <div><strong style="display: block; color: var(--text-muted); font-size: 0.9rem; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 0.5rem;">Location</strong><span style="font-size: 1.25rem; font-weight: 700; color: var(--text);"><%= project.location %></span></div>
    <div><strong style="display: block; color: var(--text-muted); font-size: 0.9rem; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 0.5rem;">Date</strong><span style="font-size: 1.25rem; font-weight: 700; color: var(--text);"><%= new Date(project.project_date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></span></div>
  </div>
  <h2 style="font-size: 2rem; font-weight: 800; margin-bottom: 1.5rem; color: var(--primary);">Project Overview</h2>
  <p style="font-size: 1.15rem; line-height: 1.8; color: var(--text);"><%= project.project_description %></p>
</div>
<%- include('partials/footer') %>